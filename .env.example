# Optional: set this to enable live Gemini AI responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database file path (default is project-root agrivanta.db)
AGRIVANTA_DB=agrivanta.db

# Replace with a long random value before deployment
AGRIVANTA_SECRET_KEY=change-this-to-a-long-random-secret
# Set to 1 only when deployed behind HTTPS
COOKIE_SECURE=0
